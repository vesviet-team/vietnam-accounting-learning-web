# .env.example — COPY to .env and replace every placeholder.
# NEVER commit a real .env. All values below are placeholders.

# Postgres connection string (required).
DATABASE_URL=postgres://user:password@localhost:5432/vietnam_accounting?sslmode=disable

# PEM-encoded RSA private key used for RS256 access-token signing (required).
# Generate a fresh key locally (do NOT reuse across environments):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 2>/dev/null | openssl pkcs8 -topk8 -nocrypt -outform PEM
# Paste the full PEM here (multi-line) or use \n-escaped single line.
JWT_SIGNING_KEY=-----BEGIN PRIVATE KEY-----\nPLACEHOLDER_REPLACE_WITH_GENERATED_KEY\n-----END PRIVATE KEY-----

# OAuth issuer URL (default: https://hoa.tanhdev.com).
OAUTH_ISSUER=https://hoa.tanhdev.com

# HTTP port (default: 8080).
PORT=8080

# P0 static first-party client (required; must match the frontend discovery metadata).
OAUTH_CLIENT_ID=vietnam-accounting-web
OAUTH_CLIENT_REDIRECT_URI=https://hoa.tanhdev.com/oauth/callback
